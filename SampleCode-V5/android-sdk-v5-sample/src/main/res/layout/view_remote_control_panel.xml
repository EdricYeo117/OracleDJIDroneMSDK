<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/remote_panel_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/remote_panel_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardUseCompatPadding="true"
            app:cardElevation="4dp"
            app:cardCornerRadius="8dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_remote_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Remote Listener"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_remote_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status: Unknown" />

                <TextView
                    android:id="@+id/tv_remote_ip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IP: -, Port: 18080" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="8dp">

                    <Button
                        android:id="@+id/btn_remote_start"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Start" />

                    <Button
                        android:id="@+id/btn_remote_stop"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Stop" />
                </LinearLayout>

                <!-- NEW: Python Server (Intruder Server) Target -->
                <TextView
                    android:id="@+id/tv_python_server_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Python server (intruder-server)"
                    android:paddingTop="12dp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingTop="6dp">

                    <EditText
                        android:id="@+id/et_python_host"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="IP / Host (e.g. 192.168.1.49)"
                        android:inputType="text"
                        android:maxLines="1" />

                    <EditText
                        android:id="@+id/et_python_port"
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:hint="Port"
                        android:inputType="number"
                        android:maxLines="1" />
                </LinearLayout>

                <Button
                    android:id="@+id/btn_save_python_server"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Save server"
                    android:layout_marginTop="8dp" />

                <!-- Existing: Upload URL (now can be derived from host/port, but still editable) -->
                <EditText
                    android:id="@+id/et_red_upload_url"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Upload URL (optional)"
                    android:inputType="textUri"
                    android:paddingTop="12dp" />

                <Button
                    android:id="@+id/btn_photo_upload"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Take Photo + Upload"
                    android:layout_marginTop="8dp" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
